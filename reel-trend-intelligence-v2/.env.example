# Copy to .env and fill in as needed. Secrets are NEVER committed.
# All settings are RTI_-prefixed; nested fields use a double underscore.

# --- storage ---
RTI_STORAGE__BACKEND=sqlite
RTI_STORAGE__SQLITE_PATH=data/rti.db
# For Postgres+TimescaleDB+pgvector (docker compose):
# RTI_STORAGE__BACKEND=postgres
# RTI_STORAGE__POSTGRES_DSN=postgresql://rti:rti@localhost:5432/rti

# --- active collection source set (config-driven) ---
RTI_COLLECTION__ENABLED_ADAPTERS=["sample"]
# Enable the live tier once credentials are set:
# RTI_COLLECTION__ENABLED_ADAPTERS=["sample","graph_api","licensed_provider","owned_session"]
RTI_COLLECTION__REQUESTS_PER_MINUTE=30
RTI_COLLECTION__DAILY_REQUEST_CAP=5000

# --- feature extraction (ML) ---
RTI_FEATURES__EMBEDDING_BACKEND=deterministic   # or "real" (CLIP/MiniLM)
RTI_FEATURES__DEVICE=auto                        # auto|cuda|cpu (auto CPU fallback)
RTI_FEATURES__BATCH_SIZE=16
RTI_FEATURES__VRAM_CAP_MB=3200                   # leave headroom on a 4 GB GPU

# --- niche for whitespace detection ---
RTI_APP__NICHE=food/restaurant

# =====================================================================
# SECRETS (adapter credentials) — leave blank to keep an adapter inert
# =====================================================================
# Instagram Graph API (Business/Creator)
RTI_GRAPH_API_TOKEN=
RTI_GRAPH_API_IG_USER_ID=

# Licensed third-party provider
RTI_PROVIDER_BASE_URL=
RTI_PROVIDER_API_KEY=

# Owned-account authenticated session (gray-area; halts on any challenge)
RTI_OWNED_SESSION_COOKIE=

# =====================================================================
# V2 ANALYSER — the VLM that describes how each reel was shot
# =====================================================================
# LOCAL BY DEFAULT: runs on your GPU, free, offline, no key needed.
RTI_ANALYSER__VLM_PROVIDER=local
RTI_ANALYSER__LOCAL_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
RTI_ANALYSER__MAX_CALLS_PER_HOUR=200

# --- To use a hosted model instead: add a key and flip the provider ---
# 'auto' picks a hosted model the moment a key exists, else stays local.
# RTI_ANALYSER__VLM_PROVIDER=auto

# Option A — Claude
# ANTHROPIC_API_KEY=
# RTI_ANALYSER__ANTHROPIC_MODEL=claude-opus-5

# Option B — ANY OpenAI-compatible provider (OpenAI, OpenRouter, Together,
# Groq, DeepInfra, Fireworks, self-hosted vLLM). Just a key + a model name.
# OPENAI_API_KEY=
# RTI_ANALYSER__OPENAI_MODEL=gpt-4o
#
# ...or point it elsewhere, e.g. OpenRouter:
# OPENROUTER_API_KEY=
# RTI_ANALYSER__OPENAI_API_KEY_ENV=OPENROUTER_API_KEY
# RTI_ANALYSER__OPENAI_BASE_URL=https://openrouter.ai/api/v1
# RTI_ANALYSER__OPENAI_MODEL=anthropic/claude-3.5-sonnet
